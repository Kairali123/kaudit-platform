{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["bom1"],
  "buildCommand": "npm run web:build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "{apps/web/dist,src}/**"
    },
    "api/monthly-report-csv.ts": {
      "maxDuration": 180,
      "includeFiles": "{apps/web/dist,src}/**"
    },
    "api/monthly-report-pdf.ts": {
      "maxDuration": 180,
      "includeFiles": "{apps/web/dist,src}/**"
    },
    "api/reconciliation-batch.ts": {
      "maxDuration": 300,
      "includeFiles": "{apps/web/dist,src}/**"
    },
    "api/audit-monitor-refresh.ts": {
      "maxDuration": 300,
      "includeFiles": "{apps/web/dist,src}/**"
    },
    "api/reports-page.ts": {
      "maxDuration": 120,
      "includeFiles": "{apps/web/dist,src}/**"
    },
    "api/billing-page.ts": {
      "maxDuration": 120,
      "includeFiles": "{apps/web/dist,src}/**"
    }
  },
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    {
      "src": "/api/v1/reports/monthly.csv",
      "dest": "/api/monthly-report-csv"
    },
    {
      "src": "/api/v1/reports/monthly.pdf",
      "dest": "/api/monthly-report-pdf"
    },
    {
      "src": "/api/v1/reconciliation/batch",
      "dest": "/api/reconciliation-batch"
    },
    {
      "src": "/api/v1/audits/refresh",
      "dest": "/api/audit-monitor-refresh"
    },
    { "src": "/api/v1/reports", "dest": "/api/reports-page" },
    { "src": "/api/v1/billing", "dest": "/api/billing-page" },
    { "src": "/(.*)", "dest": "/api" }
  ]
}
