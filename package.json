{
  "name": "kaudit-platform",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Kairali Voice Agent Call Audit & Billing Platform — decoupled audit application (separate from the KCRM app; connects to the same MySQL kaudit_* tables).",
  "engines": { "node": ">=24" },
  "scripts": {
    "test": "node --test \"src/**/*.test.ts\"",
    "test:w3": "node --test src/storage/verifyEvidenceUrl.test.ts src/security/urlSafety.test.ts src/adapters/proxyResolvingFetcher.test.ts",
    "test:backfill": "node --test src/backfill/normalizeRecordingUrl.test.ts src/backfill/backfillSourceUrl.test.ts",
    "test:w1": "node --test src/identity/resolveIdentity.test.ts src/identity/buildUserSet.test.ts src/identity/access.test.ts",
    "typecheck": "tsc --noEmit",
    "w3:verify": "node --env-file-if-exists=.env src/cli/run-verification.ts",
    "w3:backfill": "node --env-file-if-exists=.env src/cli/run-backfill.ts",
    "w1:identity": "node --env-file-if-exists=.env src/cli/run-identity-backfill.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1093.0",
    "mysql2": "^3.18.2"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
