{
  "name": "kaudit-platform",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Kairali Voice Agent Call Audit & Billing Platform — decoupled audit application (separate from the KCRM app; connects to the same MySQL kaudit_* tables).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "npm run secrets:scan && npm run typecheck && npm run web:typecheck && npm run web:build && npm test",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:w3": "node --test src/storage/verifyEvidenceUrl.test.ts src/security/urlSafety.test.ts src/adapters/proxyResolvingFetcher.test.ts",
    "test:backfill": "node --test src/backfill/normalizeRecordingUrl.test.ts src/backfill/backfillSourceUrl.test.ts",
    "test:w1": "node --test src/identity/resolveIdentity.test.ts src/identity/buildUserSet.test.ts src/identity/access.test.ts",
    "test:billing": "node --test src/billing/*.test.ts",
    "test:reaudit": "node --test src/reaudit/*.test.ts",
    "test:billing:mysql": "node --test src/adapters/mysqlVerifiedBilling.integration.test.ts",
    "test:reliability:mysql": "node --test src/adapters/mysqlReliableProcessing.integration.test.ts",
    "test:ui": "node --test src/ui/metrics.test.ts src/ui/render.test.ts src/ui/decimal.test.ts src/ui/periods.test.ts src/ui/fullDashboard.test.ts src/ui/fullRender.test.ts",
    "typecheck": "tsc --noEmit",
    "web:typecheck": "tsc -p apps/web/tsconfig.json --noEmit",
    "web:dev": "vite apps/web --config apps/web/vite.config.ts",
    "web:build": "vite build apps/web --config apps/web/vite.config.ts",
    "app:dev": "concurrently -k -n api,web -c cyan,green \"KAUDIT_AUTH_MODE=preview npm run ui:secure\" \"npm run web:dev\"",
    "app:dev:secure": "concurrently -k -n api,web -c cyan,green \"npm run ui:secure\" \"npm run web:dev\"",
    "app:preview": "npm run web:build && KAUDIT_AUTH_MODE=preview KAUDIT_SECURE_PORT=4176 npm run ui:secure",
    "app:start": "npm run web:build && npm run ui:secure",
    "ui:monitor": "node --env-file-if-exists=.env src/cli/run-monitor.ts",
    "ui:sample": "node src/cli/render-sample.ts",
    "ui:dashboard": "node --env-file-if-exists=.env src/cli/run-full-dashboard.ts",
    "ui:secure": "node --env-file-if-exists=.env --env-file-if-exists=.env.local src/cli/run-secure-dashboard.ts",
    "ui:dashboard:sample": "node src/cli/render-full-sample.ts",
    "w3:verify": "node --env-file-if-exists=.env src/cli/run-verification.ts",
    "w3:backfill": "node --env-file-if-exists=.env src/cli/run-backfill.ts",
    "w1:identity": "node --env-file-if-exists=.env src/cli/run-identity-backfill.ts",
    "w1:grant-admin": "node --env-file-if-exists=.env src/cli/run-admin-grant.ts",
    "reaudit:sample": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=$HOME/.kcrm-audit/.env.local src/cli/run-reaudit-sample.ts",
    "audit:worker": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=$HOME/.kcrm-audit/.env.local src/cli/run-reaudit-worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1093.0",
    "@tanstack/react-query": "^5.101.4",
    "jose": "^6.2.4",
    "lucide-react": "^1.26.0",
    "mysql2": "^3.18.2",
    "openai": "^6.49.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.3",
    "typescript": "^5.6.0",
    "vite": "^8.1.5"
  }
}
