# --- New durable evidence store (India region; versioned + Object-Lock + KMS) ---
KAUDIT_DURABLE_BUCKET=
KAUDIT_DURABLE_REGION=ap-south-1
KAUDIT_DURABLE_ENDPOINT=
KAUDIT_DURABLE_KMS_KEY_ID=
KAUDIT_OBJECT_LOCK_MODE=GOVERNANCE
KAUDIT_OBJECT_LOCK_RETAIN_DAYS=3650

# --- Source (current) store to migrate FROM ---
KAUDIT_SOURCE_LOCAL_ROOT=../kcrm/.data/kaudit-evidence
KAUDIT_SOURCE_MINIO_ENDPOINT=http://127.0.0.1:9000
KAUDIT_SOURCE_MINIO_ACCESS_KEY_ID=
KAUDIT_SOURCE_MINIO_SECRET_ACCESS_KEY=

# --- Database (same instance as KCRM; migration updates evidence_object location only) ---
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Safety switch: migration refuses to write unless set to EXECUTE ---
KAUDIT_MIGRATION_MODE=dry-run
KAUDIT_MIGRATION_BATCH=100
