# --- Vendor recording URL verification (KServe-hosted evidence) ---
# Comma-separated allowlist of hosts that recording URLs may point at.
KAUDIT_ALLOWED_RECORDING_HOSTS=recordings.kserve.co.in,kserve.co.in

# --- Database (same instance as KCRM; verification writes hash/verified/findings) ---
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Safety switch: verification writes nothing unless set to EXECUTE ---
KAUDIT_VERIFY_MODE=dry-run
KAUDIT_VERIFY_BATCH=100
