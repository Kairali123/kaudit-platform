# --- Vendor recording verification (KServe recordings via the unpod.ai proxy) ---
# The proxy streams recording bytes directly: GET {base}?url={s3_object_url} -> 200 audio/*
KAUDIT_UNPOD_PROXY_BASE=https://unpod.ai/api/v1/media/download-signed-url/
# Allowlist of S3 hosts that `source_url` (the stored, stable S3 object URL) may point at.
KAUDIT_ALLOWED_RECORDING_HOSTS=cdr-storage-recs.s3.ap-south-1.amazonaws.com

# --- Database (same instance as KCRM; verification writes hash/verified/findings) ---
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Safety switch: verification writes nothing unless set to EXECUTE ---
KAUDIT_VERIFY_MODE=dry-run
KAUDIT_VERIFY_BATCH=100
