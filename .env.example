# TEMPLATE ONLY — copy to `.env` (gitignored) and put real values THERE, never here.
# This file is tracked by git; it must never contain real credentials.

# --- Vendor recording verification (KServe recordings via the unpod.ai proxy) ---
# The proxy streams recording bytes directly: GET {base}?url={s3_object_url} -> 200 audio/*
KAUDIT_UNPOD_PROXY_BASE=https://unpod.ai/api/v1/media/download-signed-url/
# Allowlist of hosts a recording reference may resolve through. The canonical `source_url`
# is the S3 object URL; the proxy wrapper is unwrapped during backfill regardless.
KAUDIT_ALLOWED_RECORDING_HOSTS=unpod.ai,cdr-storage-recs.s3.ap-south-1.amazonaws.com

# --- Database (same instance as KCRM) — fill these in .env, NOT here ---
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# DB_TLS_MODE — how this deployment connects to MySQL. Exactly two values are
# accepted, `required` and `disabled`, and anything else (including `off`,
# `false`, or `0`) is refused at startup rather than guessed at.
#
#   required  (the default, and what an unset or blank value means)
#             TLS with a verified authority. Production requires exactly one of
#             the two CA variables below; the certificate must chain to it AND
#             have been issued for DB_HOST.
#   disabled  Plaintext, matching the transport the CRM already uses against the
#             same database instance. This is a deliberate downgrade and must be
#             written here to happen: a missing CA is NEVER read as consent to
#             plaintext, in production or anywhere else. Neither CA variable may
#             be set in this mode — configured trust material that would be
#             ignored is rejected instead, so what this file says is what the
#             connection does.
DB_TLS_MODE=disabled
# The two CA sources, used by `required` mode only. EXACTLY ONE of them.
# Setting both is rejected: after a CA rotation only one of them is current, and
# a runtime that silently prefers the other keeps trusting a stale authority.
#
# DB_SSL_CA_FILE — path to a CA PEM mounted by the host. Use this for the
# persistent server, the workers, and every CLI.
DB_SSL_CA_FILE=
# DB_SSL_CA_PEM — the CA PEM inline, for a platform that mounts no secret files
# (the Vercel Function). Store it as a secret-managed environment variable; a
# single-line value with `\n` separators is accepted. Never commit the PEM,
# never put it in a database field, and never log it.
DB_SSL_CA_PEM=

# --- Secure dashboard server ---
# `database` is the production username/email + password mode. `local` requires
# one environment-configured development user.
# `preview` is loopback-only, has no real identity, and never writes access logs.
NODE_ENV=development
KAUDIT_AUTH_MODE=local
KAUDIT_SECURE_HOST=127.0.0.1
KAUDIT_SECURE_PORT=4175
KAUDIT_TRUST_PROXY=false

# Local mode still resolves a provisioned kaudit_user and its roles. It does not
# create users, grant roles, or bypass an unassigned/disabled account.
KAUDIT_DEV_USER_EMAIL=
KAUDIT_LOCAL_PASSWORD_HASH=
KAUDIT_LOCAL_SESSION_SECRET=
KAUDIT_LOCAL_SESSION_COOKIE=kaudit_local_session
KAUDIT_LOCAL_SESSION_TTL_SEC=28800
# Local password login is loopback-development only. Store the real hash and
# Store local-development secrets only in ignored .env.local files.

# Database-backed multi-user login. Password hashes live only in
# kaudit_user_credential; this secret signs short-lived browser sessions and
# belongs in the deployment secret store, never in this tracked template.
KAUDIT_DATABASE_SESSION_SECRET=
KAUDIT_DATABASE_SESSION_COOKIE=kaudit_user_session
KAUDIT_DATABASE_SESSION_TTL_SEC=28800

# OIDC/JWT validation. Configure these from the Kairali identity application.
KAUDIT_OIDC_ISSUER=
KAUDIT_OIDC_AUDIENCE=
KAUDIT_OIDC_JWKS_URI=
# Browser entry point owned by Kairali's identity provider or approved
# identity-aware proxy. The app never collects passwords itself.
KAUDIT_OIDC_LOGIN_URL=
# Identity-provider/proxy endpoint that terminates the authenticated session
# and returns the browser to an approved location.
KAUDIT_OIDC_LOGOUT_URL=
# Optional cookie name when an approved identity-aware proxy forwards the raw
# signed OIDC token in a Secure, HttpOnly cookie. Authorization: Bearer is also
# supported. Never put a token in a URL.
KAUDIT_OIDC_TOKEN_COOKIE=
# Comma-separated allowlist; defaults to RS256,PS256,ES256.
KAUDIT_OIDC_ALGORITHMS=RS256,PS256,ES256
# Maximum accepted age of a presented ID token, in seconds (60..3600). Bounds the
# `iat` claim only: the signature, issuer, audience and `exp` are always verified
# and no value here can skip them. Left unset the default is 900 for a
# proxy-supplied token and 3600 when the browser flow below is on, because a
# conforming provider issues ID tokens with a one-hour lifetime and a 15-minute
# ceiling would bounce the operator back through the provider four times an hour.
KAUDIT_OIDC_MAX_TOKEN_AGE_SEC=

# --- OIDC authorization-code browser flow (this app is the OAuth client) ---
# Opt-in for the app running the sign-in itself — GET /api/v1/auth/oidc/login and
# GET /api/v1/auth/oidc/callback — instead of receiving a token from an
# identity-aware proxy. Deny-by-default and all-or-nothing: with the gate off,
# setting any of the three variables below is rejected rather than silently
# half-enabling a browser-facing login; with the gate on, all three plus
# KAUDIT_OIDC_TOKEN_COOKIE are required and KAUDIT_OIDC_LOGIN_URL must be unset
# (two login entry points is the ambiguous state). Requires KAUDIT_AUTH_MODE=oidc.
# Provider endpoints are discovered from KAUDIT_OIDC_ISSUER, so no provider URL
# is configured here. Scopes are fixed at `openid email profile`; there is no
# offline access, no refresh token, and no provider API call.
KAUDIT_OIDC_BROWSER_FLOW=false
KAUDIT_OIDC_CLIENT_ID=
# Real value belongs in the platform's secret store or ignored .env, NEVER here.
# It is read once into the auth client and is deliberately absent from runtime
# configuration, from every log line, and from every response.
KAUDIT_OIDC_CLIENT_SECRET=
# Must be this deployment's own HTTPS origin plus exactly
# /api/v1/auth/oidc/callback, with no query. Register the same string with the
# provider: it is what the token exchange sends and what the provider matches.
KAUDIT_OIDC_REDIRECT_URI=

# --- Bind a pre-provisioned kaudit_user to an OIDC identity (npm run w1:bind-oidc) ---
# Authorization plumbing only: it binds ONE existing user to ONE issuer+subject so
# that identity resolves at login. It never creates a user, activates or disables
# one, grants or revokes a role, or changes a sensitivity ceiling — and nothing in
# the application ever binds an identity by matching an email during sign-in.
# Dry-run by default; only the exact word EXECUTE writes. Arm a real run inline:
#   KAUDIT_OIDC_BIND_MODE=EXECUTE npm run w1:bind-oidc
KAUDIT_OIDC_BIND_MODE=dry-run
# The pre-provisioned administrator address, under the same @kairali.com policy
# the grant command uses. The user must already exist; a missing one is refused.
KAUDIT_OIDC_BIND_EMAIL=
# The provider's issuer identifier, exactly as it appears in the `iss` claim —
# HTTPS, no credentials, no query, no fragment. It is stored verbatim because
# login compares it byte for byte, so a trailing slash that the provider does not
# send would produce a binding that matches nothing.
KAUDIT_OIDC_BIND_ISSUER=
# The provider's opaque `sub` for that person. Read it from a VALIDATED Google ID
# token or the identity-admin console; it can never be worked out from the email
# address, and a guess binds the account to whoever really owns that subject.
# Do not paste an ID token into a shell, a log, a ticket, or this repository —
# only the `sub` value belongs here. See docs/runbooks/ADMIN_ACCESS.md.
KAUDIT_OIDC_BIND_SUBJECT=

# --- Safety switch: verification writes nothing unless set to EXECUTE ---
KAUDIT_VERIFY_MODE=dry-run
KAUDIT_VERIFY_BATCH=100

# --- Backfill: populate source_url from raw KServe export payloads ---
# Historical-only Kaudit-owned import root. Never point runtime processing at KCRM.
KAUDIT_SOURCE_RAW_ROOT=.data/legacy-raw-imports
KAUDIT_BACKFILL_MODE=dry-run
KAUDIT_BACKFILL_BATCH=100

# --- Monthly usage CSV + invoice PDF imports ---
# Private, gitignored Kaudit-owned storage. Production should mount a restricted
# company-owned persistent volume at this path.
KAUDIT_IMPORT_ROOT=.data/imports
# Optional only when the database has exactly one active KServe source connection.
# Set explicitly when more than one source connection exists.
KAUDIT_KSERVE_SOURCE_CONNECTION_ID=

# --- Continuous independent audit worker ---
# The worker refuses to write unless this is exactly EXECUTE. It always skips calls
# already backed by a completed audit result (legacy or V2).
KAUDIT_AUDIT_MODE=dry-run
KAUDIT_AUDIT_BATCH=10
KAUDIT_AUDIT_WATCH=false
KAUDIT_AUDIT_DRAIN=false
KAUDIT_AUDIT_SCOPE_FILE=
# Set true for supervised/test runs that must fail closed without an exact scope file.
KAUDIT_AUDIT_REQUIRE_SCOPE=false
KAUDIT_CYCLE_CLOSE_MODE=DRY-RUN
KAUDIT_CYCLE_CLOSE_MONTH=
KAUDIT_CYCLE_CLOSE_RATE_CARD_ID=
KAUDIT_CYCLE_CLOSE_BATCH=1000
# Leadership-approved zero-human-review validation. A second independent model
# pass must agree on category and rounded billable duration. This is automated
# consensus, not human-labeled ground-truth calibration.
KAUDIT_AUTO_VALIDATE_MODE=DRY-RUN
KAUDIT_AUTO_VALIDATE_MONTH=
KAUDIT_AUTO_VALIDATE_RATE_CARD_ID=
KAUDIT_AUTO_VALIDATE_BATCH=10
# Provisional cycle report. Persistence is off by default because an uncalibrated
# preview is not an authoritative bill or vendor-dispute calculation.
KAUDIT_REPORT_MONTH=
KAUDIT_REPORT_OUTPUT=
KAUDIT_REPORT_PERSIST_PREVIEW=false
KAUDIT_REPORT_RATE_CARD_ID=
KAUDIT_REPORT_CREATED_BY=
KAUDIT_AUDIT_POLL_MS=15000
OPENAI_API_KEY=
# Bounded hosted workers stop claiming new items before their host deadline.
KAUDIT_WORKER_DEADLINE_SECONDS=19200
# For local use, keep the real key outside the repository at
# $HOME/.kcrm-audit/.env.local. The audit commands load that file last.

# --- Call Audit: admin rule test lab ---
# Opt-in for the admin-only rule test lab (POST /api/v1/call-audit/settings/test)
# on the secure dashboard. Deny-by-default and separate from OPENAI_API_KEY on
# purpose: the key above is already set for unrelated import analysis, so only
# this flag counts as consent to spend on a content model. Both this flag set to
# exactly `true` AND a nonblank OPENAI_API_KEY are required; with either missing
# the endpoint reports itself unavailable before reading a request body.
# It runs ONE transcript an administrator types, persists nothing, and audits no
# production call. Turning it on adds no worker, schedule, or report.
KAUDIT_CALL_AUDIT_RULE_TEST_ENABLED=false

# --- Dashboard worker control mode ---
# disabled: Resume is unavailable. github: Resume dispatches the bounded hosted
# workflow. persistent: Resume writes durable MySQL intent only; independently
# supervised workers are already polling it. Use persistent for the 24/7 server.
# An unset value preserves the legacy KAUDIT_GITHUB_WORKER_ENABLED behavior.
KAUDIT_AUDIT_WORKER_CONTROL_MODE=disabled

# GitHub fallback only. The token is held by the dashboard runtime and should be
# fine-grained with Actions: write and no content-write grant. Persistent mode
# neither requires nor calls GitHub.
KAUDIT_GITHUB_WORKER_ENABLED=false
KAUDIT_GITHUB_WORKER_REPOSITORY=
KAUDIT_GITHUB_WORKER_REF=
KAUDIT_GITHUB_WORKER_TOKEN=

# --- Call Audit: one-shot batch CLI (npm run callaudit:batch) ---
# An operator entry point, not a scheduler: it runs ONE bounded batch over ONE
# period supplied below and exits. Writes and model spend are refused unless the
# mode is exactly EXECUTE, so leave the default here and arm a real run inline:
#   KAUDIT_CALL_AUDIT_BATCH_MODE=EXECUTE npm run callaudit:batch
KAUDIT_CALL_AUDIT_BATCH_MODE=dry-run
# One of the run types the control repository accepts: daily, monthly,
# quarterly, yearly, manual, test, backfill.
KAUDIT_CALL_AUDIT_RUN_TYPE=manual
# The CALENDAR period the run records, expressed in the timezone below.
KAUDIT_CALL_AUDIT_PERIOD_START=
KAUDIT_CALL_AUDIT_PERIOD_END_EXCLUSIVE=
KAUDIT_CALL_AUDIT_PERIOD_TIMEZONE=Asia/Kolkata
# The SOURCE window actually scanned, in the source's UTC-naive form. It is
# stated separately on purpose: converting a calendar period into these
# boundaries is a scheduling decision and this CLI makes none.
KAUDIT_CALL_AUDIT_SOURCE_START=
KAUDIT_CALL_AUDIT_SOURCE_END_EXCLUSIVE=
# Required and never generated. Re-running the same command with the same key
# rejoins the run it already created instead of paying to audit the period twice.
KAUDIT_CALL_AUDIT_IDEMPOTENCY_KEY=
# Optional ceilings. The batch size defaults to 25; the two limits are unset,
# meaning the run reads the period to exhaustion.
KAUDIT_CALL_AUDIT_BATCH_SIZE=25
KAUDIT_CALL_AUDIT_MAX_PAGES=
KAUDIT_CALL_AUDIT_MAX_CANDIDATES=
# Optional provenance recorded on the run row.
KAUDIT_CALL_AUDIT_CORRELATION_ID=
KAUDIT_CALL_AUDIT_TRIGGERED_BY=

# --- Call Audit: automatic change-feed worker (npm run callaudit:worker) ---
# Required only on the first launch, before migration 0012 has a checkpoint.
# UTC-naive inclusive watermark. Once initialized, the database checkpoint wins
# and this value is never used to move an existing checkpoint.
KAUDIT_CALL_AUDIT_AUTO_START=
# New/changed source rows are polled every minute by default. This is a worker
# setting, not a per-run approval gate; administrator Stop/Resume is durable SQL.
KAUDIT_CALL_AUDIT_POLL_MS=60000
KAUDIT_CALL_AUDIT_DRAIN=false

# Release gates are deny-by-default. Do not enable without the named approvals
# and evidence described in DECISIONS_NEEDED.md.
KAUDIT_CALIBRATION_COMPLETE=false
# Alternative zero-human-review authority policy. This never claims measured
# ground-truth accuracy; every accepted call needs a traced model consensus.
KAUDIT_AUTOMATED_VALIDATION_APPROVED=false
KAUDIT_REPORTING_APPROVED=false

# --- Automated authoritative report email ---
KAUDIT_REPORT_EMAIL_ENABLED=false
KAUDIT_EMAIL_TRANSPORT=gmail-oauth
KAUDIT_REPORT_RECIPIENTS=
KAUDIT_REPORT_FROM=
KAUDIT_REPORT_EMAIL_MONTH=
KAUDIT_REPORT_EMAIL_WATCH=false
KAUDIT_REPORT_EMAIL_POLL_MS=60000
# One-shot recovery only, supplied inline after transport repair.
KAUDIT_REPORT_EMAIL_REPLAY_DEAD_LETTER=false
# Preferred Gmail API OAuth transport.
KAUDIT_GOOGLE_CLIENT_ID=
KAUDIT_GOOGLE_CLIENT_SECRET=
KAUDIT_GOOGLE_REFRESH_TOKEN=
# Legacy SMTP transport; used only with KAUDIT_EMAIL_TRANSPORT=smtp.
KAUDIT_SMTP_HOST=
KAUDIT_SMTP_PORT=587
KAUDIT_SMTP_SECURE=false
KAUDIT_SMTP_USER=
KAUDIT_SMTP_PASSWORD=
